# Non-secret development settings (committed). Secrets live in creds.env.
NAUTOBOT_DEBUG=True
NAUTOBOT_LOG_LEVEL=INFO
NAUTOBOT_ALLOWED_HOSTS=*

# Database (PostgreSQL)
NAUTOBOT_DB_ENGINE=django.db.backends.postgresql
NAUTOBOT_DB_HOST=db
NAUTOBOT_DB_PORT=5432
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
POSTGRES_DB=nautobot
POSTGRES_USER=nautobot

# Redis
NAUTOBOT_REDIS_HOST=redis
NAUTOBOT_REDIS_PORT=6379

# --- MCP Server app config -------------------------------------------------
# Point the app at the local Nautobot. Use a token created in the dev instance.
NAUTOBOT_URL=http://localhost:8080
NAUTOBOT_ALLOW_WRITES=False
NAUTOBOT_MCP_PLUGINS=auto
MCP_LOG_LEVEL=INFO
