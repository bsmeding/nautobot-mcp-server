# Copy to creds.env (gitignored) and fill in. NEVER commit creds.env.
NAUTOBOT_CREATE_SUPERUSER=True
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
NAUTOBOT_SUPERUSER_PASSWORD=admin
NAUTOBOT_SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567

# Django / Nautobot secret key (generate your own for anything non-local)
NAUTOBOT_SECRET_KEY=changeme-dev-secret-key

# Database password
NAUTOBOT_DB_PASSWORD=changeme
POSTGRES_PASSWORD=changeme

# Redis password
NAUTOBOT_REDIS_PASSWORD=changeme
REDIS_PASSWORD=changeme

# --- MCP Server app token --------------------------------------------------
# Token the app uses to call Nautobot's API (match the superuser token above
# for local dev, or a dedicated scoped token).
NAUTOBOT_TOKEN=0123456789abcdef0123456789abcdef01234567
